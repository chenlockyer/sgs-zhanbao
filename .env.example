# 复制成 .env 后填自己的值。.env 已在 .gitignore 里，不会进仓库。

# ── 必填 ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 工作目录（默认当前目录；产物落 <SGS_HOME>/{data,output,voice2text}）──
# SGS_HOME=D:\work\zhanbao

# ── 换 LLM 网关（任何兼容 OpenAI Chat Completions 的都可以）──
# SGS_LLM_BASE_URL=https://api.deepseek.com
# SGS_LLM_MODEL=deepseek-chat
# SGS_LLM_TEMPERATURE=0.35
# SGS_LLM_MAX_TOKENS=8192
# SGS_LLM_TIMEOUT=300
# SGS_LLM_MAX_RETRIES=3
# SGS_LLM_JSON_MODE=1        # 网关不支持 response_format 时设 0

# ── 换素材 / 术语表 / 提示词 / 字体 ──
# SGS_ART=D:\my\art           # 目录里放 head.png / mid.png / tail.png
# SGS_GLOSSARY=D:\my\glossary.yaml
# SGS_PROMPTS=D:\my\prompts
# SGS_FONT=C:\Windows\Fonts\simkai.ttf

# ── 出图 ──
# SGS_REPORTER=战报记者：某某-某某
# SGS_SCALE=2.0

# ── 本地转写（用 sgs-zhanbao-local 时才需要）──
# SGS_ASR_MODELS=D:\models
